# 东方智慧智能体环境变量示例
# 复制为仓库根目录 .env 或 integration/.env，再填入实际值。
# integration/config_secure.py 的 load_config() 会读取这两个文件，且不会覆盖已经导出的环境变量。

# ==================== 服务（对齐 security.server） ====================
# server.host
HOST=127.0.0.1
# server.port
PORT=5000
# server.debug。生产姿态默认关闭，不要在生产环境设为 true
DEBUG=false

# ==================== 认证（至少配置一项） ====================
# api_keys.keys：逗号分隔，请求头 X-API-Key
# API_KEYS=key-one,key-two
# 单个密钥也可写成 API_KEY（并入 api_keys.keys）
# API_KEY=

# bearer_auth.token：请求头 Authorization: Bearer <token>
# 与 BEARER_TOKEN 同义，填一个即可
API_AUTH_TOKEN=change-me
# BEARER_TOKEN=

# ==================== 访问控制 ====================
# ip_whitelist.enabled。桌面本地调试可设 false；公网部署再打开并收紧 TRUSTED_IPS
ENABLE_IP_WHITELIST=false
TRUSTED_IPS=127.0.0.1,::1,localhost

# rate_limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# input_validation.max_request_size_bytes
MAX_REQUEST_SIZE_BYTES=1048576

# CORS。本地桌面客户端可设 true；生产环境改为精确来源
ALLOW_ALL_ORIGINS=false
ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ==================== 客户端地址 ====================
ORIENTAL_AGENT_URL=http://127.0.0.1:5000

# ==================== OpenClaw ====================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
# OpenClaw webhook 自己的令牌，不等同于上面的 API_AUTH_TOKEN
WEBHOOK_AUTH_TOKEN=your_webhook_auth_token

# ==================== Hermes ====================
HERMES_TELEGRAM_TOKEN=your_hermes_telegram_token

# ==================== 其他 ====================
# logging.level
LOG_LEVEL=INFO
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
MAX_WORKERS=4

# 预测免责声明，默认开启。设为 false 才关闭
PREDICTION_HEURISTIC_DISCLAIMER=true
