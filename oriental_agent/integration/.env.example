# 东方智慧智能体 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== API服务配置 ====================
# API服务地址
ORIENTAL_AGENT_URL=http://localhost:5000

# API认证令牌（可选）
# API_AUTH_TOKEN=your_auth_token_here

# ==================== OpenClaw 配置 ====================
# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id

# Webhook 认证
WEBHOOK_AUTH_TOKEN=your_webhook_auth_token

# ==================== Hermes Agent 配置 ====================
# Hermes Telegram Token（同OpenClaw）
# 如果使用独立的Hermes实例
HERMES_TELEGRAM_TOKEN=your_hermes_telegram_token

# ==================== 其他配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Flask密钥
FLASK_SECRET_KEY=change_this_to_a_random_secret_key

# 最大并发数
MAX_WORKERS=4
