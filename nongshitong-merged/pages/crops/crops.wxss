.container {
  min-height: 100vh;
  background: #f5f5f0;
  padding-bottom: 30rpx;
}

.search-bar {
  padding: 30rpx;
  background: #ffffff;
}

.search-input {
  display: flex;
  align-items: center;
  background: #f5f5f0;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

.category-tabs {
  padding: 24rpx 30rpx;
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  background: #ffffff;
  margin-bottom: 20rpx;
}

.category-tab {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  white-space: nowrap;
  background: #f0f7ee;
  color: #2d5a27;
  transition: all 0.3s;
}

.category-tab.active {
  background: #2d5a27;
  color: #ffffff;
}

.crops-grid {
  padding: 0 30rpx;
}

.crop-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.crop-card:active {
  transform: scale(0.98);
}

.crop-icon {
  font-size: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #f0f7ee;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.crop-info {
  flex: 1;
}

.crop-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.crop-category {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.crop-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.crop-tags .tag {
  background: #f0f7ee;
  color: #2d5a27;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.arrow {
  font-size: 40rpx;
  color: #cccccc;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 50rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
