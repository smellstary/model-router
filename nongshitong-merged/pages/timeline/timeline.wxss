.container {
  min-height: 100vh;
  background: #f5f5f0;
  padding-bottom: 30rpx;
}

.header {
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  padding: 30rpx;
  padding-top: env(safe-area-inset-top);
  color: #ffffff;
}

.year-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 30rpx;
}

.year {
  font-size: 40rpx;
  font-weight: 700;
}

.year-btn {
  font-size: 48rpx;
  padding: 10rpx 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.view-tabs {
  display: flex;
  justify-content: center;
  gap: 60rpx;
}

.tab {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  opacity: 0.6;
  transition: all 0.3s;
}

.tab.active {
  opacity: 1;
  background: rgba(255, 255, 255, 0.3);
}

.terms-scroll {
  padding: 30rpx;
}

.terms-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.term-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.term-item.current {
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  color: #ffffff;
  transform: scale(1.05);
}

.term-icon {
  font-size: 48rpx;
}

.term-name {
  font-size: 28rpx;
  font-weight: 600;
}

.term-date {
  font-size: 22rpx;
  opacity: 0.7;
}

.current-indicator {
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.current-tag {
  display: inline-block;
  background: linear-gradient(135deg, #ff9800 0%, #ffb74d 100%);
  color: #ffffff;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.month-content {
  padding: 30rpx;
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.month-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.month-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d5a27;
  margin-bottom: 16rpx;
  display: block;
}

.month-terms {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.month-term-tag {
  background: #f0f7ee;
  color: #2d5a27;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.year-content {
  padding: 30rpx;
}

.season-section {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.season-header {
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  color: #ffffff;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.season-icon {
  font-size: 36rpx;
}

.season-name {
  font-size: 30rpx;
  font-weight: 600;
}

.season-terms {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rpx;
  background: #f0f0f0;
}

.season-term {
  background: #ffffff;
  padding: 24rpx;
  text-align: center;
}

.st-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.st-date {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.term-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.detail-card {
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  width: 100%;
  max-height: 70vh;
  overflow: hidden;
}

.detail-header {
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  color: #ffffff;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.detail-icon {
  font-size: 64rpx;
}

.detail-title {
  flex: 1;
}

.detail-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.detail-date {
  font-size: 26rpx;
  opacity: 0.8;
}

.close-btn {
  font-size: 40rpx;
  padding: 10rpx 20rpx;
}

.detail-content {
  padding: 30rpx;
}

.detail-desc {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.farming-tips {
  background: #f9f9f9;
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d5a27;
  margin-bottom: 20rpx;
  display: block;
}

.tips-list text {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 2;
}
