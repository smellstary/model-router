.container {
  min-height: 100vh;
  background: #f5f5f0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.plots-section, .diaries-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.add-btn {
  background: #2d5a27;
  color: #ffffff;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.plots-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plot-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.plot-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.plot-icon {
  font-size: 48rpx;
  width: 80rpx;
  height: 80rpx;
  background: #f0f7ee;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plot-info {
  flex: 1;
}

.plot-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.plot-area {
  font-size: 24rpx;
  color: #999999;
}

.plot-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.plot-status.active {
  background: #e8f5e9;
  color: #2d5a27;
}

.plot-status.idle {
  background: #f5f5f0;
  color: #999999;
}

.plot-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.plot-tags .tag {
  background: #f5f5f0;
  color: #666666;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.plot-crops {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.crop-tag {
  background: #e8f5e9;
  color: #2d5a27;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.plot-empty {
  font-size: 24rpx;
  color: #cccccc;
}

.empty-plots, .empty-diaries {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 80rpx 30rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

.diaries-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.diary-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.diary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.diary-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d5a27;
}

.diary-plot {
  font-size: 24rpx;
  color: #999999;
  background: #f5f5f0;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.diary-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.diary-weather {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  padding: 10rpx;
}

.modal-form {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f5f5f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .form-input {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  background: #f5f5f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-textarea {
  background: #f5f5f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 200rpx;
}

.btn-submit {
  margin: 0 30rpx 30rpx;
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 24rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}
