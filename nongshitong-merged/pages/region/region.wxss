.container {
  min-height: 100vh;
  background: #f5f5f0;
  padding-bottom: 100rpx;
}

.header {
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  padding: 60rpx 30rpx 40rpx;
  color: #ffffff;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
}

.search-bar {
  padding: 30rpx;
  background: #ffffff;
}

.search-input {
  display: flex;
  align-items: center;
  background: #f5f5f0;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

.regions-list {
  padding: 20rpx 30rpx;
}

.region-item {
  background: #ffffff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s;
}

.region-item:active {
  background: #f9f9f9;
}

.region-name {
  font-size: 30rpx;
  color: #333333;
}

.region-check {
  width: 40rpx;
  height: 40rpx;
  background: #2d5a27;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.region-check text {
  color: #ffffff;
  font-size: 24rpx;
}

.current-location {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.location-icon {
  font-size: 36rpx;
}

.location-text {
  font-size: 30rpx;
  color: #2d5a27;
  font-weight: 500;
}
