.container {
  min-height: 100vh;
  background: #f5f5f0;
  padding: 30rpx;
  padding-bottom: 200rpx;
}

.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.step-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.step-dot.active {
  background: #2d5a27;
}

.step-dot.completed {
  background: #4caf50;
}

.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 10rpx;
  transition: all 0.3s;
}

.step-line.active {
  background: #2d5a27;
}

.step-title {
  text-align: center;
  margin-bottom: 40rpx;
}

.step-title text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.step-content {
  min-height: 400rpx;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.form-input {
  background: #f5f5f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  width: 100%;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .form-input {
  flex: 1;
}

.picker-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
}

.crop-selection {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.crop-title {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.crop-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.crop-item {
  background: #f5f5f0;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  transition: all 0.3s;
  border: 4rpx solid transparent;
}

.crop-item.selected {
  background: #e8f5e9;
  border-color: #2d5a27;
}

.crop-icon {
  font-size: 48rpx;
}

.crop-name {
  font-size: 24rpx;
  color: #333333;
}

.summary-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.summary-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2d5a27;
  margin-bottom: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 28rpx;
  color: #999999;
}

.summary-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-prev {
  flex: 1;
  background: #f5f5f0;
  color: #666666;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 24rpx;
  border: none;
}

.btn-prev::after {
  border: none;
}

.btn-next, .btn-complete {
  flex: 2;
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 24rpx;
  border: none;
}

.btn-next::after, .btn-complete::after {
  border: none;
}
