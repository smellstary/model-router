page {
  height: 100%;
  background-color: #f5f5f0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
}

view, text, scroll-view {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d5a27;
  margin-bottom: 24rpx;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.gap-10 {
  gap: 10rpx;
}

.gap-16 {
  gap: 16rpx;
}

.gap-24 {
  gap: 24rpx;
}

.text-primary {
  color: #2d5a27;
}

.text-secondary {
  color: #666666;
}

.text-muted {
  color: #999999;
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 600;
}

.text-sm {
  font-size: 24rpx;
}

.text-base {
  font-size: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #2d5a27 0%, #4a8f43 100%);
  color: #ffffff;
  border-radius: 44rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #f0f7ee;
  color: #2d5a27;
  border-radius: 44rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  background: #f0f7ee;
  color: #2d5a27;
}

.tag-active {
  background: #2d5a27;
  color: #ffffff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 50rpx;
  color: #999999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

page {
  --primary-color: #2d5a27;
  --secondary-color: #4a8f43;
  --bg-color: #f5f5f0;
  --card-bg: #ffffff;
  --text-primary: #1a1a1a;
  --text-secondary: #666666;
  --text-muted: #999999;
}
